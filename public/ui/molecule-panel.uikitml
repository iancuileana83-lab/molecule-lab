<!--
  Molecule Lab level panel. Panel, Divider, Button, ButtonIcon and ButtonLabel
  come from the bundled Horizon kit; ArrowRight, ArrowLeft, Eye, RotateCcw, Star
  Volume2 and RectangleGoggles are Lucide. Runtime ids: header, level-name,
  instructions, title-block, game-ui, progress, hint, fact-box, fact-text,
  score-box, star-1..3,
  score-text, best-text, all-done, next-button,
  play-again-button, guide-button, guide-label, sound-button, sound-label,
  restart-button, xr-button.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 430px;
  }

  .header {
    flex-direction: column;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 14px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: #dcebe8;
  }

  .title {
    font-size: 31px;
    font-weight: 700;
    color: #1f2a2a;
  }

  .level-name {
    margin-top: 4px;
    font-size: 21px;
    font-weight: 500;
    color: #2e5f58;
  }

  .body {
    flex-direction: column;
    padding-top: 14px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .instructions {
    font-size: 20px;
    line-height: 1.35;
    color: #2b2b2b;
  }

  .progress {
    margin-top: 14px;
    font-size: 30px;
    font-weight: 700;
    color: #1f2a2a;
    text-align: center;
  }

  .hint {
    margin-top: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #fbe3df;
    font-size: 19px;
    line-height: 1.3;
    color: #8a1f14;
    text-align: center;
  }

  .fact-box {
    flex-direction: column;
    margin-top: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    background-color: #eef7f1;
  }

  .fact-text {
    font-size: 19px;
    line-height: 1.35;
    color: #1f3a2c;
  }

  .score-box {
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
  }

  .stars-row {
    flex-direction: row;
    gap: 26px;
  }

  .star-cell {
    flex-direction: column;
    align-items: center;
  }

  .star-icon {
    width: 40px;
    height: 40px;
    color: #c9ccc8;
  }

  .star-label {
    margin-top: 2px;
    font-size: 15px;
    color: #4a5a58;
  }

  .score-text {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    color: #1f2a2a;
  }

  .best-text {
    margin-top: 2px;
    font-size: 17px;
    color: #2e5f58;
  }

  .all-done {
    margin-top: 12px;
    font-size: 22px;
    font-weight: 700;
    color: #2e5f58;
    text-align: center;
  }

  .button {
    margin-top: 14px;
    margin-left: 22px;
    margin-right: 22px;
    justify-content: center;
  }

  .button-label {
    font-size: 19px;
  }

  .game-ui {
    flex-direction: column;
  }

  .title-block {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .title-desc {
    font-size: 21px;
    line-height: 1.35;
    color: #2b2b2b;
  }

  .title-credit {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.4;
    color: #5b6b69;
  }

  .enter-button {
    height: 58px;
  }

  .enter-label {
    font-size: 24px;
    font-weight: 700;
  }

  .button-row {
    flex-direction: row;
    gap: 10px;
    margin-top: 14px;
    margin-left: 22px;
    margin-right: 22px;
  }

  .row-button {
    width: 188px;
    justify-content: center;
  }

  .last-button {
    margin-bottom: 20px;
  }
</style>
<Panel class="panel-root">
  <div id="header" class="header">
    <div class="title">Molecule Lab</div>
    <div id="level-name" class="level-name">Level 1: Paracetamol</div>
  </div>
  <div id="title-block" class="title-block" style="display: none">
    <div class="title-desc">
      Build the molecules of everyday medicines. Hands only, no controllers
      needed.
    </div>
    <div class="title-credit">
      Made by Ileana Mazilu, a pharmacy professional with 20 years in community
      pharmacy.
    </div>
  </div>
  <div id="game-ui" class="game-ui">
  <div class="body">
    <div id="instructions" class="instructions">
      Pinch an atom and bring it next to the floating carbon. Correct bonds
      snap into place.
    </div>
    <div id="progress" class="progress">Bonds: 0 / 11</div>
    <div id="hint" class="hint" style="display: none">Hint</div>
    <div id="fact-box" class="fact-box" style="display: none">
      <div id="fact-text" class="fact-text">Fact</div>
    </div>
    <div id="score-box" class="score-box" style="display: none">
      <div class="stars-row">
        <div class="star-cell">
          <Star id="star-1" class="star-icon"></Star>
          <div class="star-label">Built</div>
        </div>
        <div class="star-cell">
          <Star id="star-2" class="star-icon"></Star>
          <div class="star-label">Time</div>
        </div>
        <div class="star-cell">
          <Star id="star-3" class="star-icon"></Star>
          <div class="star-label">Precision</div>
        </div>
      </div>
      <div id="score-text" class="score-text">Time 0:00 | Mistakes 0</div>
      <div id="best-text" class="best-text">Best: -</div>
    </div>
    <div id="all-done" class="all-done" style="display: none">
      You built every molecule!
    </div>
  </div>
  <Button id="next-button" class="button" style="display: none">
    <ButtonLabel class="button-label">Next molecule</ButtonLabel>
    <ButtonIcon>
      <ArrowRight></ArrowRight>
    </ButtonIcon>
  </Button>
  <Button id="play-again-button" class="button" style="display: none">
    <ButtonIcon>
      <ArrowLeft></ArrowLeft>
    </ButtonIcon>
    <ButtonLabel class="button-label">Play again from level 1</ButtonLabel>
  </Button>
  <div class="button-row">
    <Button id="guide-button" class="row-button">
      <ButtonIcon>
        <Eye></Eye>
      </ButtonIcon>
      <ButtonLabel id="guide-label" class="button-label">Hide guide</ButtonLabel>
    </Button>
    <Button id="sound-button" class="row-button">
      <ButtonIcon>
        <Volume2></Volume2>
      </ButtonIcon>
      <ButtonLabel id="sound-label" class="button-label">Mute</ButtonLabel>
    </Button>
  </div>
  <Button id="restart-button" class="button last-button">
    <ButtonIcon>
      <RotateCcw></RotateCcw>
    </ButtonIcon>
    <ButtonLabel class="button-label">Build again</ButtonLabel>
  </Button>
  </div>
  <Button id="xr-button" class="button last-button enter-button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label enter-label">Enter VR</ButtonLabel>
  </Button>
</Panel>
