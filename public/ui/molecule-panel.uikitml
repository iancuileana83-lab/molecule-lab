<!--
  Molecule Lab level panel. Panel, Divider, Button, ButtonIcon and ButtonLabel
  come from the bundled Horizon kit; ArrowRight, ArrowLeft, RotateCcw, Settings
  and RectangleGoggles are Lucide. The fact and the score live on the separate
  info card (info-card.uikitml). Runtime ids: header, level-name, title-block,
  game-ui, play-page, formula-img, instructions, progress, hint, all-done,
  next-button, play-again-button, settings-button, restart-button,
  settings-page, guide-button, guide-label, sound-button, sound-label,
  calm-button, calm-label, motion-button, motion-label, reach-button,
  reach-label, dist-near/normal/far, height-low/normal/high (+ "-label"),
  back-button, xr-button, molecules-button, molecules-page, mol-0 .. mol-5 (+ "-label"),
  mol-back-button.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 430px;
  }

  .header {
    flex-direction: column;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: #dcebe8;
  }

  .title {
    font-size: 31px;
    font-weight: 700;
    color: #1f2a2a;
  }

  .level-name {
    margin-top: 4px;
    font-size: 21px;
    font-weight: 500;
    color: #2e5f58;
  }

  .body {
    flex-direction: column;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .instructions {
    font-size: 20px;
    line-height: 1.35;
    color: #2b2b2b;
  }

  .progress {
    margin-top: 10px;
    font-size: 30px;
    font-weight: 700;
    color: #1f2a2a;
    text-align: center;
  }

  .hint {
    margin-top: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #fbe3df;
    font-size: 19px;
    line-height: 1.3;
    color: #8a1f14;
    text-align: center;
  }

  .all-done {
    margin-top: 12px;
    font-size: 22px;
    font-weight: 700;
    color: #2e5f58;
    text-align: center;
  }

  .button {
    margin-top: 10px;
    margin-left: 22px;
    margin-right: 22px;
    justify-content: center;
  }

  .button-label {
    font-size: 19px;
  }

  .game-ui {
    flex-direction: column;
  }

  .page {
    flex-direction: column;
  }

  .title-block {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .title-desc {
    font-size: 21px;
    line-height: 1.35;
    color: #2b2b2b;
  }

  .title-credit {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.4;
    color: #5b6b69;
  }

  .formula-img {
    width: 360px;
    height: 168px;
    margin-top: 10px;
    margin-left: 35px;
    margin-right: 35px;
  }

  .enter-button {
    height: 58px;
  }

  .enter-label {
    font-size: 24px;
    font-weight: 700;
  }

  .button-row {
    flex-direction: row;
    gap: 10px;
    margin-top: 10px;
    margin-left: 22px;
    margin-right: 22px;
  }

  .row-button {
    width: 188px;
    justify-content: center;
  }

  .tri-button {
    width: 122px;
    justify-content: center;
  }

  .legend {
    margin-top: 12px;
    margin-left: 22px;
    margin-right: 22px;
    font-size: 16px;
    line-height: 1.3;
    color: #4a5856;
    text-align: center;
  }

  .wide-button {
    margin-top: 10px;
    margin-left: 22px;
    margin-right: 22px;
    justify-content: center;
  }

  .seg-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    margin-left: 22px;
    margin-right: 22px;
  }

  .seg-label {
    width: 96px;
    font-size: 17px;
    font-weight: 600;
    color: #2b2b2b;
  }

  .seg-button {
    width: 86px;
    justify-content: center;
  }

  .seg-text {
    font-size: 17px;
  }

  .last-button {
    margin-bottom: 20px;
  }
</style>
<Panel class="panel-root">
  <div id="header" class="header">
    <div class="title">Molecule Lab</div>
    <div id="level-name" class="level-name">Level 1: Paracetamol</div>
  </div>
  <div id="title-block" class="title-block" style="display: none">
    <div class="title-desc">
      Build the molecules of everyday medicines. Hands only, no controllers
      needed.
    </div>
    <div class="title-credit">
      Made by Ileana Mazilu, a pharmacy professional with 20 years in community
      pharmacy.
    </div>
  </div>
  <div id="game-ui" class="game-ui">
    <div id="play-page" class="page">
      <img id="formula-img" class="formula-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="></img>
      <div class="body">
        <div id="instructions" class="instructions">
          Pinch an atom and bring it next to the floating carbon. Correct bonds
          snap into place.
        </div>
        <div id="progress" class="progress">Bonds: 0 / 11</div>
        <div id="hint" class="hint" style="display: none">Hint</div>
        <div id="all-done" class="all-done" style="display: none">
          You built every molecule!
        </div>
      </div>
      <Button id="next-button" class="button" style="display: none">
        <ButtonLabel class="button-label">Next molecule</ButtonLabel>
        <ButtonIcon>
          <ArrowRight></ArrowRight>
        </ButtonIcon>
      </Button>
      <Button id="play-again-button" class="button" style="display: none">
        <ButtonIcon>
          <ArrowLeft></ArrowLeft>
        </ButtonIcon>
        <ButtonLabel class="button-label">Play again from level 1</ButtonLabel>
      </Button>
      <div id="row-play" class="button-row last-button">
        <Button id="molecules-button" class="tri-button">
          <ButtonLabel class="button-label">Molecules</ButtonLabel>
        </Button>
        <Button id="settings-button" class="tri-button">
          <ButtonLabel class="button-label">Settings</ButtonLabel>
        </Button>
        <Button id="restart-button" class="tri-button">
          <ButtonLabel class="button-label">Build again</ButtonLabel>
        </Button>
      </div>
    </div>
    <div id="molecules-page" class="page" style="display: none">
      <div id="row-mol-a" class="button-row">
        <Button id="mol-0" class="row-button">
          <ButtonLabel id="mol-0-label" class="button-label">Molecule</ButtonLabel>
        </Button>
        <Button id="mol-1" class="row-button">
          <ButtonLabel id="mol-1-label" class="button-label">Molecule</ButtonLabel>
        </Button>
      </div>
      <div id="row-mol-b" class="button-row">
        <Button id="mol-2" class="row-button">
          <ButtonLabel id="mol-2-label" class="button-label">Molecule</ButtonLabel>
        </Button>
        <Button id="mol-3" class="row-button">
          <ButtonLabel id="mol-3-label" class="button-label">Molecule</ButtonLabel>
        </Button>
      </div>
      <div id="row-mol-c" class="button-row">
        <Button id="mol-4" class="row-button">
          <ButtonLabel id="mol-4-label" class="button-label">Molecule</ButtonLabel>
        </Button>
        <Button id="mol-5" class="row-button">
          <ButtonLabel id="mol-5-label" class="button-label">Molecule</ButtonLabel>
        </Button>
      </div>
      <div class="legend">Green: built. Gold: building now.</div>
      <Button id="mol-back-button" class="button last-button">
        <ButtonIcon>
          <ArrowLeft></ArrowLeft>
        </ButtonIcon>
        <ButtonLabel class="button-label">Back to the game</ButtonLabel>
      </Button>
    </div>
    <div id="settings-page" class="page" style="display: none">
      <div id="row-a" class="button-row">
        <Button id="guide-button" class="row-button">
          <ButtonLabel id="guide-label" class="button-label">Hide guide</ButtonLabel>
        </Button>
        <Button id="sound-button" class="row-button">
          <ButtonLabel id="sound-label" class="button-label">Mute</ButtonLabel>
        </Button>
      </div>
      <div id="row-b" class="button-row">
        <Button id="calm-button" class="row-button">
          <ButtonLabel id="calm-label" class="button-label">Calm mode: Off</ButtonLabel>
        </Button>
        <Button id="motion-button" class="row-button">
          <ButtonLabel id="motion-label" class="button-label">Reduce motion: Off</ButtonLabel>
        </Button>
      </div>
      <Button id="reach-button" class="wide-button">
        <ButtonLabel id="reach-label" class="button-label">Reach assist: Off</ButtonLabel>
      </Button>
      <div id="row-dist" class="seg-row">
        <div class="seg-label">Table</div>
        <Button id="dist-near" class="seg-button">
          <ButtonLabel id="dist-near-label" class="seg-text">Near</ButtonLabel>
        </Button>
        <Button id="dist-normal" class="seg-button">
          <ButtonLabel id="dist-normal-label" class="seg-text">Normal</ButtonLabel>
        </Button>
        <Button id="dist-far" class="seg-button">
          <ButtonLabel id="dist-far-label" class="seg-text">Far</ButtonLabel>
        </Button>
      </div>
      <div id="row-height" class="seg-row">
        <div class="seg-label">Height</div>
        <Button id="height-low" class="seg-button">
          <ButtonLabel id="height-low-label" class="seg-text">Lower</ButtonLabel>
        </Button>
        <Button id="height-normal" class="seg-button">
          <ButtonLabel id="height-normal-label" class="seg-text">Normal</ButtonLabel>
        </Button>
        <Button id="height-high" class="seg-button">
          <ButtonLabel id="height-high-label" class="seg-text">Higher</ButtonLabel>
        </Button>
      </div>
      <Button id="back-button" class="button last-button">
        <ButtonIcon>
          <ArrowLeft></ArrowLeft>
        </ButtonIcon>
        <ButtonLabel class="button-label">Back to the game</ButtonLabel>
      </Button>
    </div>
  </div>
  <Button id="xr-button" class="button last-button enter-button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label enter-label">Enter VR</ButtonLabel>
  </Button>
</Panel>
